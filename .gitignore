# --- Project-specific ------------------------------------------------------

# Staged copy of the CBDB-Desktop distribution.  The zip ships a 1.2 GB
# SQLite database and two ~30 MB Go binaries; nothing under work/ is ever
# committed.  Recreate it with:  python stage.py
work/

# Per-run artefacts.  The Markdown issue reports ARE committed -- they
# are the deliverable, and their history is the record of what each build
# did.  The .docx and .pdf are generated from the same source on demand
# and are deliberately NOT committed: their internal timestamps change on
# every regeneration, so committing them would dirty the tree on every
# run for no added information.  Run reports/generate_report.py to
# produce them.
reports/_*
reports/*.json
reports/*.docx
reports/*.pdf
reports/*.new
reports/runs/
artifacts/

# Local environment pointing at the maintainer's zip / work dir.  Copy
# .env.example -> .env and edit; .env is machine-specific.
.env

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Claude / agents -------------------------------------------------------
.claude/
memory/
