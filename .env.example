# ---------------------------------------------------------------------------
# cbdb-desktop-tests — environment
#
# Copy to `.env` and edit.  `.env` is gitignored: every path below is
# machine-specific.  Anything here can also be supplied as a real
# environment variable, which takes precedence over the file.
# ---------------------------------------------------------------------------

# REQUIRED.  The CBDB-Desktop distribution under test.  This is the single
# input of the whole suite — every test runs against the binary, templates,
# Go sources and SQLite database staged out of this archive.
CBDB_DESKTOP_ZIP=C:\Users\how612\Dropbox\cbdb-desktop_20260901.zip

# Where the archive is unpacked.  Defaults to <repo>/work.  Needs ~2 GB
# free; put it on a fast local disk (NOT inside Dropbox/OneDrive — the
# 1.2 GB CBDB.db would sync on every stage).
# CBDB_WORK_DIR=C:\cbdb-desktop-work

# Skip staging entirely and test an already-unpacked CBDB-Desktop tree.
# When set, it must be a directory containing Bin/, Data/, Templates/,
# Static/ and Code/.  CBDB_DESKTOP_ZIP is then only used for provenance.
# CBDB_APP_DIR=

# Seconds to wait for cbdb.exe to log its "CBDB server started: <url>" line.
# The first start on a cold file cache opens a 1.2 GB WAL database.
CBDB_STARTUP_TIMEOUT=180

# Seconds any single HTTP request to the app may take.  Some form queries
# (networks, group data) legitimately run for a minute on the full dataset.
CBDB_HTTP_TIMEOUT=300

# 1 = launch cbdb.exe with a PATH that cannot resolve rundll32, so its
# automatic "open the default browser" call fails harmlessly instead of
# spawning a browser window per test session.  Set to 0 to see the UI.
CBDB_SUPPRESS_BROWSER=1
